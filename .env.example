# vLLM-Omni runs externally, on its own GPU host - this stack only needs to
# know how to reach its OpenAI-compatible /v1/realtime endpoint.
# e.g. `vllm-omni serve <model> --omni --host 0.0.0.0 --port 8000` started
# elsewhere, then VLLM_OMNI_BASE_URL=http://<that-host>:8000/v1
VLLM_OMNI_BASE_URL=

# Model name to request from the /v1/realtime endpoint above.
VLLM_OMNI_MODEL=
